# Backend port (the Vite dev server proxies /api and /stream to it)
PORT=3737

# demo = built-in live match simulator (default, no key needed)
# live = real fixtures from football-data.org (falls back to demo on failure)
DATA_MODE=demo

# Free key from https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# Optional: pin a football-data.org match id; otherwise the first in-play match is used
FOOTBALL_DATA_MATCH_ID=

# Screen scan ("Scan my screen" in the overlay): a vision model reads frames of the match you are watching.
# SCREEN_MODEL picks the model, and its name picks the provider:
#   claude-*  -> ANTHROPIC_API_KEY (https://console.anthropic.com). claude-opus-5-5 ~$10 per match, claude-haiku-5-5 ~40x cheaper.
#   gemini-*  -> GEMINI_API_KEY (https://aistudio.google.com/apikey). gemini-3.8-flash works on the free tier.
SCREEN_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Demo simulator: speed multiplier (1 = one match minute per 2 seconds), seed, and start minute
SIM_SPEED=1
SIM_SEED=42
SIM_START_MINUTE=24
